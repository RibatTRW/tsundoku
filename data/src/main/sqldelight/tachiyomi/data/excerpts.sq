-- Excerpt Vault (issue #53): reader-kept passages with their novel and chapter.
-- Titles and urls are copied so an excerpt outlives the novel's library entry.
CREATE TABLE excerpts(
    _id INTEGER NOT NULL PRIMARY KEY,
    excerpt_text TEXT NOT NULL,
    manga_title TEXT NOT NULL,
    chapter_name TEXT NOT NULL,
    chapter_number REAL NOT NULL,
    source_id INTEGER NOT NULL,
    manga_url TEXT NOT NULL,
    chapter_url TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    UNIQUE (created_at, excerpt_text)
);

getExcerpts:
SELECT *
FROM excerpts
ORDER BY created_at DESC;

-- OR IGNORE keeps restoring the same backup twice from duplicating entries.
insert:
INSERT OR IGNORE INTO excerpts(
    excerpt_text,
    manga_title,
    chapter_name,
    chapter_number,
    source_id,
    manga_url,
    chapter_url,
    created_at
)
VALUES (
    :text,
    :mangaTitle,
    :chapterName,
    :chapterNumber,
    :sourceId,
    :mangaUrl,
    :chapterUrl,
    :createdAt
);

delete:
DELETE FROM excerpts
WHERE _id = :excerptId;
